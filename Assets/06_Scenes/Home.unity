--- !u!114 &1084615297
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1084615295}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 493869f78e3f2814088f3299c8655ae5, type: 3}
    m_FontSize: 26
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "\u25B6 \uBAA9\uD45C\n10\uC6E8\uC774\uBE0C\uB97C \uBC84\uD168 \uC655\uAD6D\uC744 \uC9C0\uD0A4\uC138\uC694. \uC131\uBCBD HP\uAC00 0\uC774 \uB418\uBA74 \uC2E4\uD328\uD569\uB2C8\uB2E4.\n\n\u25B6 \uC900\uBE44 \uC2DC\uAC04\n\uC6A9\uBCD1 \uC8FC\uC810\uC5D0\uC11C \uC6A9\uC0AC\uB97C \uACE0\uC6A9\uD558\uBA74 \uD544\uB4DC \uBE48 \uC2AC\uB86F\uC5D0 \uBC14\uB85C \uBC30\uCE58\uB429\uB2C8\uB2E4. \uBC30\uCE58\uB41C \uC6A9\uC0AC\uB294 \uC790\uC720\uB86D\uAC8C \uB4DC\uB798\uADF8\uD574\uC11C \uC790\uB9AC\uB97C \uBC14\uAFC0 \uC218 \uC788\uC5B4\uC694.\n\n\u25B6 \uD569\uC131\n\uAC19\uC740 \uC6A9\uC0AC + \uAC19\uC740 \uC131\uAE09 3\uAE30\uAC00 \uBAA8\uC774\uBA74 \uC790\uB3D9\uC73C\uB85C \uC131\uAE09\uC774 \uC62C\uB77C \uACF5\uACA9\uB825\uC774 \uAC15\uD574\uC9D1\uB2C8\uB2E4.\n\n\u25B6 \uC6E8\uC774\uBE0C\n\uC900\uBE44 \uC2DC\uAC04\uC774 \uB05D\uB098\uBA74 \uC790\uB3D9\uC73C\uB85C \uC804\uD22C\uAC00 \uC2DC\uC791\uB3FC\uC694. \uC804\uD22C \uC911\uC5D0\uB294 \uBC30\uCE58\uB97C \uBC14\uAFC0 \uC218 \uC5C6\uC73C\uB2C8 \uBBF8\uB9AC \uC900\uBE44\uD574\uB450\uC138\uC694.\n\n\u25B6 \uC7AC\uD654\n\uAE08\uD654\uB294 \uC774\uBC88 \uCD9C\uC804\uC5D0\uC11C\uB9CC \uC4F0\uB294 \uC7AC\uD654(\uACE0\uC6A9\xB7\uB9AC\uB864), \uC655\uAD00 \uD30C\uD3B8\uC740 \uC601\uAD6C \uC7AC\uD654\uB85C \uB2E4\uC74C \uAD6C\uC5ED \uD574\uAE08\uC5D0 \uC4F0\uC785\uB2C8\uB2E4.\n\n\u25B6 \uAD6C\uC5ED\n\uAD6C\uC5ED\uC740 \uC21C\uC11C\uB300\uB85C \uD574\uAE08\uB3FC\uC694. \uB4A4\uB85C \uAC08\uC218\uB85D \uBAAC\uC2A4\uD130\uAC00 \uAC15\uD574\uC9C0\uACE0 \uAD6C\uC5ED\uB9C8\uB2E4 \uACE0\uC720\uD55C \uAE30\uBBF9\uC774 \uC788\uC2B5\uB2C8\uB2E4."
